{
  "server": {
    "host": "0.0.0.0",
    "port": 8787,
    "token": "",
    "web_password": "hive-please-change"
  },
  "llm": {
    "provider": "deepseek",
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-chat",
    "api_key": "PUT_YOUR_DEEPSEEK_API_KEY_HERE",
    "temperature": 0.2,
    "timeout": 180,
    "max_retries": 3,
    "max_tokens": 0
  },
  "react": {
    "max_steps": 20,
    "parallel_tools": false,
    "tool_timeout": 120,
    "max_history_messages": 80
  },
  "tool_output": {
    "inline_max_chars": 2000,
    "preview_chars": 400,
    "root": "data/toolout"
  },
  "secretary": {
    "session_id": "secretary",
    "auto_compact": true,
    "compact_threshold_chars": 30000,
    "keep_recent_messages": 8
  },
  "sessions": {
    "max_concurrent": 8,
    "role_timeout": 900,
    "root": "data/sessions",
    "workspace_root": "data/workspaces"
  },
  "tickets": {
    "root": "data/tickets",
    "close_reply_timeout": 120,
    "max_roles": 8,
    "default_project": "default"
  },
  "knowledge": {
    "root": "data/knowledge",
    "layers": ["public", "project", "ticket"],
    "max_inject_chars": 20000
  },
  "tools": {
    "allow_shell": true,
    "shell_timeout": 120
  },
  "observability": {
    "log_dir": "data/logs",
    "event_buffer": 500,
    "event_log_max_mb": 64
  },
  "bus": {
    "workers": 4
  },
  "ops": {
    "control_dir": "data/control"
  }
}
