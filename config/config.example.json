{
  "server": {
    "host": "0.0.0.0",
    "port": 8787,
    "token": "",
    "web_password": "hive-please-change",
    "tls": {
      "enabled": true,
      "cert": "config/tls/server.crt",
      "key": "config/tls/server.key"
    }
  },
  "llm": {
    "provider": "deepseek",
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-chat",
    "api_key": "PUT_YOUR_DEEPSEEK_API_KEY_HERE",
    "temperature": 0.2,
    "timeout": 180,
    "max_retries": 3,
    "max_tokens": 0,
    "stream": true
  },
  "react": {
    "max_steps": 20,
    "parallel_tools": false,
    "tool_timeout": 120,
    "max_history_messages": 80
  },
  "tool_output": {
    "inline_max_chars": 2000,
    "preview_chars": 400,
    "root": "data/toolout"
  },
  "secretary": {
    "session_id": "secretary",
    "auto_compact": true,
    "compact_threshold_chars": 30000,
    "keep_recent_messages": 8
  },
  "sessions": {
    "backend": "api",
    "max_concurrent": 8,
    "role_timeout": 900,
    "root": "data/sessions",
    "workspace_root": "data/workspaces"
  },
  "projects": {
    "root": "data/projects",
    "default": "default"
  },
  "tickets": {
    "root": "data/tickets",
    "close_reply_timeout": 120,
    "max_roles": 8,
    "default_project": "default",
    "pm_max_steps": 0,
    "auto_retrospective": false,
    "stall_check": {
      "enabled": false,
      "interval_sec": 300,
      "idle_minutes": 45,
      "max_per_scan": 2,
      "create_audit": true
    }
  },
  "knowledge": {
    "root": "data/knowledge",
    "layers": [
      "public",
      "project",
      "ticket"
    ],
    "max_inject_chars": 20000
  },
  "tools": {
    "allow_shell": true,
    "shell_timeout": 120
  },
  "observability": {
    "log_dir": "data/logs",
    "event_buffer": 500,
    "event_log_max_mb": 64
  },
  "bus": {
    "workers": 4
  },
  "ops": {
    "control_dir": "data/control"
  },
  "instance": {
    "id": "local-1",
    "title": "本地节点",
    "layer": "local"
  },
  "artifacts": {
    "root": "data/artifacts",
    "compress_threshold_mb": 200,
    "compress_after_days": 7
  },
  "library": {
    "root": "data/library"
  },
  "skills": {
    "root": "data/skills"
  },
  "agents": {
    "root": "data/agents",
    "claude_code": {
      "command": "claude",
      "args": ["-p", "{prompt}", "--output-format", "json", "--permission-mode", "bypassPermissions"],
      "timeout": 0,
      "env": {
        "ANTHROPIC_BASE_URL": "https://api.deepseek.com/anthropic",
        "ANTHROPIC_MODEL": "deepseek-chat",
        "ANTHROPIC_SMALL_FAST_MODEL": "deepseek-chat"
      },
      "guard": {
        "enabled": true,
        "min_free_mem_mb": 1024,
        "max_load_ratio": 1.5,
        "max_claude_procs": 3,
        "on_insufficient": "reject"
      }
    }
  },
  "gitflow": {
    "enabled": true,
    "author_name": "Hive Agent",
    "author_email": "agent@hive.local"
  },
  "trace": {
    "root": "data/traces",
    "ring": 800,
    "max_bytes": 8388608
  }
}