{
  "version": "4.6",
  "description": "Hive Agent 网页状态转移的唯一契约。改页面前先改这里，再改 app.js/index.html；tests/test_state_machine.py 负责一致性。",
  "initial": "project.home",
  "states": [
    {
      "id": "project.home",
      "view": "project",
      "route": "#/project/:project",
      "requires": ["projects.loaded"],
      "render": "openProject",
      "visible": ["projectview"],
      "events": {
        "OPEN_PROJECT": "project.home",
        "OPEN_SECRETARY": "chat.secretary",
        "OPEN_TICKET": "chat.ticket",
        "OPEN_SOURCE": "overlay.project-source",
        "OPEN_IDLE": "overlay.idle"
      }
    },
    {
      "id": "chat.secretary",
      "view": "chat",
      "route": "#/chat/sec-:project",
      "requires": ["projects.loaded", "project.secretary"],
      "render": "selectGroup",
      "visible": ["chatview"],
      "events": {
        "BACK": "project.home",
        "OPEN_TICKET": "chat.ticket",
        "OPEN_ARTIFACTS": "overlay.artifacts"
      }
    },
    {
      "id": "chat.ticket",
      "view": "chat",
      "route": "#/chat/T-:ticket",
      "requires": ["projects.loaded"],
      "render": "selectGroup",
      "visible": ["chatview"],
      "events": {
        "BACK": "project.home",
        "FORK_TICKET": "overlay.fork-ticket",
        "OPEN_ARTIFACT": "overlay.artifact",
        "COPY_TICKET": "chat.ticket"
      }
    },
    {
      "id": "overlay.library",
      "view": "overlay",
      "route": "#/library/:kind",
      "render": "openLibrary",
      "visible": ["modal"],
      "events": { "CLOSE": "project.home" }
    },
    {
      "id": "overlay.knowledge",
      "view": "overlay",
      "route": "#/knowledge",
      "render": "openKnowledge",
      "visible": ["modal"],
      "events": { "CLOSE": "project.home" }
    },
    {
      "id": "overlay.rules",
      "view": "overlay",
      "route": "#/rules",
      "render": "openRules",
      "visible": ["modal"],
      "events": { "CLOSE": "project.home", "VALIDATE": "overlay.rules" }
    },
    {
      "id": "overlay.health",
      "view": "overlay",
      "route": "#/health",
      "render": "openHealth",
      "visible": ["modal"],
      "events": { "CLOSE": "project.home" }
    },
    {
      "id": "overlay.versions",
      "view": "overlay",
      "route": "#/versions",
      "render": "openVersions",
      "visible": ["modal"],
      "events": { "CLOSE": "project.home" }
    },
    {
      "id": "overlay.project-source",
      "view": "overlay",
      "route": "#/project/:project/source/:path",
      "render": "openProjectSource",
      "visible": ["modal"],
      "events": { "CLOSE": "project.home" }
    },
    {
      "id": "overlay.artifacts",
      "view": "overlay",
      "route": "#/chat/:group/artifacts",
      "render": "loadFiles",
      "visible": ["side"],
      "events": { "CLOSE": "chat.secretary" }
    },
    {
      "id": "overlay.artifact",
      "view": "overlay",
      "route": "#/chat/:group/artifact/:path",
      "render": "openArtifact",
      "visible": ["modal"],
      "events": { "CLOSE": "chat.ticket", "DOWNLOAD": "overlay.artifact" }
    },
    {
      "id": "overlay.fork-ticket",
      "view": "overlay",
      "route": "#/chat/:group/fork",
      "render": "openFork",
      "visible": ["modal"],
      "events": { "CREATE": "chat.ticket", "CLOSE": "chat.ticket" }
    },
    {
      "id": "overlay.idle",
      "view": "overlay",
      "route": "#/project/:project/idle",
      "render": "openIdle",
      "visible": ["modal"],
      "events": { "FLUSH": "project.home", "CLOSE": "project.home" }
    }
  ],
  "forbidden": {
    "global_secretary": true,
    "top_tabs": ["chat", "source"],
    "global_idle_chip": true
  },
  "components": {
    "required_ids": [
      "pv-idle-enabled", "pv-idle-windows", "pv-idle-discount", "pv-idle-force",
      "pv-saveidle", "pv-idle", "pv-delete",
      "lc-archive", "lc-delete", "lc-tickets", "lc-artifacts",
      "lc-knowledge", "lc-main", "lc-source"
    ]
  }
}
