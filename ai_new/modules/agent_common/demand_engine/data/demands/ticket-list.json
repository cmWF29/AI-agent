{
  "id": "ticket-list",
  "title": "列工单：遍历 tickets/*/ticket.json 后成形",
  "enabled": true,
  "callable": true,
  "on": [],
  "do": [
    {
      "call": "store.walk",
      "with": {
        "module": {
          "lit": "agent/tickets"
        },
        "root": {
          "lit": "tickets"
        },
        "pattern": {
          "lit": "*/ticket.json"
        }
      },
      "as": "rows"
    },
    {
      "call": "tickets.screen",
      "with": {
        "status": {
          "get": "input.status"
        },
        "project": {
          "get": "input.project"
        },
        "rows": {
          "get": "rows.rows"
        }
      },
      "as": "out"
    }
  ],
  "expect": {
    "given": {
      "input": {}
    },
    "calls": [
      "store.walk",
      "tickets.screen"
    ],
    "payload": {},
    "promise": "遍历归需求"
  }
}
