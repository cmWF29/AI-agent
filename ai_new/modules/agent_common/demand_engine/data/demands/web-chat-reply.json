{
  "id": "web-chat-reply",
  "title": "网页发一条消息 → 编排对话 → 回复写回同一个频道",
  "enabled": true,
  "on": [
    "channel.posted"
  ],
  "do": [
    {
      "when": {
        "op": "==",
        "a": {
          "get": "event.data.role"
        },
        "b": "user"
      },
      "then": [
        {
          "call": "channel.tail",
          "with": {
            "channel": {
              "get": "event.data.channel"
            },
            "limit": {
              "lit": 20
            }
          },
          "as": "history"
        },
        {
          "call": "demand_engine.run",
          "with": {
            "id": {
              "lit": "llm-chat"
            },
            "input": {
              "messages": {
                "op": "append",
                "a": {
                  "get": "history.messages"
                },
                "b": {
                  "role": "user",
                  "content": {
                    "get": "event.data.content"
                  }
                }
              }
            }
          },
          "as": "reply"
        },
        {
          "when": {
            "op": "!=",
            "a": {
              "get": "reply.ok"
            },
            "b": true
          },
          "then": [
            {
              "call": "demand_engine.run",
              "with": {
                "id": {
                  "lit": "channel-post"
                },
                "input": {
                  "channel": {
                    "get": "event.data.channel"
                  },
                  "role": {
                    "lit": "system"
                  },
                  "content": {
                    "op": "+",
                    "a": {
                      "lit": "模型调用失败："
                    },
                    "b": {
                      "get": "reply.result.error"
                    }
                  }
                }
              }
            }
          ],
          "else": [
            {
              "call": "demand_engine.run",
              "with": {
                "id": {
                  "lit": "channel-post"
                },
                "input": {
                  "channel": {
                    "get": "event.data.channel"
                  },
                  "role": {
                    "lit": "assistant"
                  },
                  "content": {
                    "get": "reply.result.content"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "expect": {
    "given": {
      "on": "channel.posted",
      "event": {
        "data": {
          "channel": "web",
          "role": "user",
          "content": "你好"
        }
      },
      "input": {
        "text": "hi"
      }
    },
    "calls": [
      "channel.tail",
      "demand_engine.run",
      "demand_engine.run"
    ],
    "payload": {
      "channel.tail": {
        "channel": {
          "get": "event.data.channel"
        }
      }
    },
    "promise": "用户消息进来，跑一遍对话编排，回复落同一个频道；编排失败回一条系统提示，不死循环"
  }
}
