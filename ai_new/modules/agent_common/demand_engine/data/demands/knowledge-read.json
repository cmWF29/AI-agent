{
  "id": "knowledge-read",
  "title": "读知识：归一 id → 算路径 → 取文本 → 有则返回，无则报缺",
  "enabled": true,
  "callable": true,
  "on": [],
  "do": [
    {
      "call": "store.id",
      "with": {
        "value": {
          "get": "input.project"
        }
      },
      "as": "pid"
    },
    {
      "call": "store.id",
      "with": {
        "value": {
          "get": "input.ticket"
        }
      },
      "as": "tid"
    },
    {
      "call": "knowledge.scope",
      "with": {
        "layer": {
          "get": "input.layer"
        },
        "project": {
          "get": "pid.id"
        },
        "ticket": {
          "get": "tid.id"
        }
      },
      "as": "scope"
    },
    {
      "call": "store.id",
      "with": {
        "value": {
          "get": "input.name"
        }
      },
      "as": "nid"
    },
    {
      "call": "knowledge.doc",
      "with": {
        "prefix": {
          "get": "scope.prefix"
        },
        "name": {
          "get": "nid.id"
        }
      },
      "as": "doc"
    },
    {
      "call": "store.read_text",
      "with": {
        "module": {
          "lit": "agent/knowledge"
        },
        "path": {
          "get": "doc.path"
        }
      },
      "as": "file"
    },
    {
      "when": {
        "op": "==",
        "a": {
          "get": "file.value"
        },
        "b": ""
      },
      "then": [
        {
          "call": "knowledge.missing",
          "with": {
            "name": {
              "get": "input.name"
            }
          },
          "as": "out"
        }
      ],
      "else": [
        {
          "call": "knowledge.view",
          "with": {
            "path": {
              "get": "doc.path"
            },
            "content": {
              "get": "file.value"
            }
          },
          "as": "out"
        }
      ]
    }
  ],
  "expect": {
    "given": {
      "input": {}
    },
    "calls": [
      "store.id",
      "store.id",
      "knowledge.scope",
      "store.id",
      "knowledge.doc",
      "store.read_text",
      "knowledge.missing"
    ],
    "payload": {},
    "promise": "路径由模块算，内容由 store 给，读不到就报缺"
  }
}
