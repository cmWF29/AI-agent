{
  "id": "projects-archive",
  "title": "归档项目：读一次 → 打归档标记（带时间）→ 落盘 → 露出字段",
  "enabled": true,
  "callable": true,
  "on": [],
  "do": [
    {
      "call": "store.id",
      "with": {
        "value": {
          "get": "input.id"
        }
      },
      "as": "id"
    },
    {
      "call": "store.read",
      "with": {
        "module": {
          "lit": "agent/projects"
        },
        "path": {
          "op": "+",
          "a": {
            "get": "id.id"
          },
          "b": {
            "lit": ".json"
          }
        }
      },
      "as": "row"
    },
    {
      "call": "clock.now",
      "as": "now"
    },
    {
      "call": "projects.archive",
      "with": {
        "rec": {
          "get": "row.value"
        },
        "now": {
          "get": "now.ts"
        }
      },
      "as": "rec"
    },
    {
      "call": "store.write",
      "with": {
        "module": {
          "lit": "agent/projects"
        },
        "path": {
          "op": "+",
          "a": {
            "get": "id.id"
          },
          "b": {
            "lit": ".json"
          }
        },
        "value": {
          "get": "rec"
        }
      },
      "as": "w"
    },
    {
      "call": "projects.view",
      "with": {
        "rec": {
          "get": "rec"
        }
      },
      "as": "out"
    }
  ],
  "expect": {
    "given": {
      "input": {}
    },
    "calls": [
      "store.id",
      "store.read",
      "clock.now",
      "projects.archive",
      "store.write",
      "projects.view"
    ],
    "payload": {},
    "promise": "标记与时间都由需求带进来，模块纯计算"
  }
}
