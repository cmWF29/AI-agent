{
  "id": "knowledge-write",
  "title": "写知识：归一 id → 算路径 → append 或覆盖 → 回执",
  "enabled": true,
  "callable": true,
  "on": [],
  "do": [
    {
      "call": "store.id",
      "with": {
        "value": {
          "get": "input.project"
        }
      },
      "as": "pid"
    },
    {
      "call": "store.id",
      "with": {
        "value": {
          "get": "input.ticket"
        }
      },
      "as": "tid"
    },
    {
      "call": "knowledge.scope",
      "with": {
        "layer": {
          "get": "input.layer"
        },
        "project": {
          "get": "pid.id"
        },
        "ticket": {
          "get": "tid.id"
        }
      },
      "as": "scope"
    },
    {
      "call": "store.id",
      "with": {
        "value": {
          "get": "input.name"
        }
      },
      "as": "nid"
    },
    {
      "call": "knowledge.doc",
      "with": {
        "prefix": {
          "get": "scope.prefix"
        },
        "name": {
          "get": "nid.id"
        }
      },
      "as": "doc"
    },
    {
      "when": {
        "op": "==",
        "a": {
          "get": "input.mode"
        },
        "b": "append"
      },
      "then": [
        {
          "call": "store.append_text",
          "with": {
            "module": {
              "lit": "agent/knowledge"
            },
            "path": {
              "get": "doc.path"
            },
            "text": {
              "op": "+",
              "a": {
                "lit": "\n\n"
              },
              "b": {
                "get": "input.content"
              }
            }
          },
          "as": "w"
        }
      ],
      "else": [
        {
          "call": "store.write_text",
          "with": {
            "module": {
              "lit": "agent/knowledge"
            },
            "path": {
              "get": "doc.path"
            },
            "text": {
              "get": "input.content"
            }
          },
          "as": "w"
        }
      ]
    },
    {
      "call": "knowledge.view",
      "with": {
        "path": {
          "get": "doc.path"
        },
        "content": {
          "get": "input.content"
        }
      },
      "as": "out"
    }
  ],
  "expect": {
    "given": {
      "input": {}
    },
    "calls": [
      "store.id",
      "store.id",
      "knowledge.scope",
      "store.id",
      "knowledge.doc",
      "store.write_text",
      "knowledge.view"
    ],
    "payload": {},
    "promise": "append 与覆盖是两条路，都在需求里分"
  }
}
