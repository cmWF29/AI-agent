{
  "id": "skills-get",
  "title": "技能详情：取回技能卡后挑一张",
  "enabled": true,
  "callable": true,
  "on": [],
  "do": [
    {
      "call": "store.read",
      "with": {
        "module": {
          "lit": "agent/library"
        },
        "path": {
          "lit": "skills.json"
        }
      },
      "as": "rows"
    },
    {
      "call": "skills.get",
      "with": {
        "items": {
          "get": "rows.value"
        },
        "id": {
          "get": "input.id"
        }
      },
      "as": "out"
    }
  ],
  "expect": {
    "given": {
      "input": {}
    },
    "calls": [
      "store.read",
      "skills.get"
    ],
    "payload": {},
    "promise": "挑卡归模块"
  }
}
