#!/bin/sh
# 服务端推送门禁：安装到 VPS bare 仓库 hooks/pre-receive，拒绝架构扫描失败的推送。
# Hive 生产裸仓库通常由 watch/部署脚本管理；先备份原 hook 再替换。
set -e
fail=0
while read old new ref; do
  case "$ref" in
    refs/heads/main|refs/heads/master) ;;
    *) continue ;;
  esac
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  git archive "$new" | tar -x -C "$tmp"
  if [ -f "$tmp/hive/archscan.py" ]; then
    if ! (cd "$tmp" && PYTHONPATH="$tmp" python3 -m hive.archscan); then
      echo "[arch-gate] rejected $ref ($new): architecture scan failed" >&2
      fail=1
    fi
  fi
done
exit "$fail"
