      "requirements": ["req-09", "req-18"]
    },
    {
      "id": "ui.projects.agents",
      "ui": "projects",
      "target": "agents",
      "prefix": "/api/agents",
      "methods": ["GET"],
      "intent": "项目页读取 Agent 后端配置",
      "requirements": ["req-08"]
    },
    {
      "id": "ui.projects.ops",
      "ui": "projects",
      "target": "ops",
      "prefix": "/api/ops",
      "methods": ["GET", "POST"],
      "intent": "项目页读取文件/配置并打开配置面板",
      "requirements": ["req-11", "req-13"]
    },
    {
      "id": "ui.projects.web",
      "ui": "projects",
