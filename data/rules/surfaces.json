      "methods": ["GET", "POST"],
      "intent": "群聊读取工单流、标签并投递消息",
      "requirements": ["req-23", "req-24", "req-30"]
    },
    {
      "id": "ui.webchat.sessions",
      "ui": "webchat",
      "target": "sessions",
